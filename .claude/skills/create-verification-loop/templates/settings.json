{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop-verify.sh\" --session-start", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/init-guard.sh\" --session-start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop-verify.sh\" --user-prompt", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/init-guard.sh\"", "timeout": 10 },
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pr-guard.sh\"", "timeout": 60 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/stop-verify.sh\"", "timeout": 600, "statusMessage": "Verifying what this session changed (fast gate)…" }
        ]
      }
    ]
  }
}
